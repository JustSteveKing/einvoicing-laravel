{
    "name": "einvoicing/laravel",
    "description": "Peppol e-invoicing for Laravel: validate, convert and look up documents with the einvoicing.dev API.",
    "keywords": [
        "laravel",
        "peppol",
        "e-invoicing",
        "en16931",
        "ubl",
        "vat"
    ],
    "homepage": "https://www.einvoicing.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Steve McDougall",
            "homepage": "https://www.juststeveking.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "einvoicing/sdk": "^0.3",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Einvoicing\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Einvoicing\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Einvoicing\\Laravel\\EinvoicingServiceProvider"
            ],
            "aliases": {
                "Einvoicing": "Einvoicing\\Laravel\\Facades\\Einvoicing"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "stan": "phpstan analyse",
        "lint": "pint"
    },
    "support": {
        "issues": "https://github.com/JustSteveKing/einvoicing-laravel/issues",
        "source": "https://github.com/JustSteveKing/einvoicing-laravel",
        "docs": "https://www.einvoicing.dev/docs"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Any PSR-18 client and PSR-17 factories will do; this is the one most Laravel apps already have."
    }
}
